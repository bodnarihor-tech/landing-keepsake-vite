section#journal.section.journal
  .container
    h2.section-title From the journal
    p.section-lead Notes on process, case studies and things that inspire us.
    .journal-grid
      each post in journalPosts
        article.journal-card
          img.journal-card__thumb(
            src=post.src
            alt=post.alt
            width='150'
            height='150'
            loading='lazy'
          )
          .journal-card__body
            p.journal-card__meta= post.meta
            h3.journal-card__title= post.title
            p.journal-card__excerpt= post.excerpt
            a.journal-card__link(href=post.href) Read more &rsaquo;
