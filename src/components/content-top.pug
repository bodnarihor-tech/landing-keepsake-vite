section.hero
  .container
    h1.hero__title We&apos;re Keepsake, a digital &amp; branding agency
    p.hero__subtitle Specializing in web design, poster, motion video, based in London. We love to turn ideas into beautiful things.
    .hero__actions
      a.btn.btn--primary(href='#works') See our works
      a.btn.btn--outline(href='#contact') Get in touch

section#works.section.portfolio
  .container
    .portfolio__top
      h2.section-title Our awesome works
      .filters-wrapper
        input#filter-all.filter-input.filter-input--all(
          type='radio'
          name='portfolio-filter'
          checked
        )
        input#filter-branding.filter-input.filter-input--branding(
          type='radio'
          name='portfolio-filter'
        )
        input#filter-identity.filter-input.filter-input--identity(
          type='radio'
          name='portfolio-filter'
        )
        input#filter-print.filter-input.filter-input--print(
          type='radio'
          name='portfolio-filter'
        )
        input#filter-web.filter-input.filter-input--web(
          type='radio'
          name='portfolio-filter'
        )
        input#filter-motion.filter-input.filter-input--motion(
          type='radio'
          name='portfolio-filter'
        )
        .filters(role='group' aria-label='Filter works by category')
          label.chip.chip--all(for='filter-all') All
          label.chip.chip--branding(for='filter-branding') Branding
          label.chip.chip--identity(for='filter-identity') Identity
          label.chip.chip--print(for='filter-print') Print
          label.chip.chip--web(for='filter-web') Web
          label.chip.chip--motion(for='filter-motion') Motion
        .portfolio-grid
          article.work-card(data-category='branding')
            a.work-card__link(href='#work-1')
              img.work-card__img(
                src='../assets/work-01.webp'
                alt='Mock-up tag branding project'
                width='400'
                height='316'
              )
              .work-card__overlay
                span.work-card__plus(aria-hidden='true') +
                h3.work-card__title Clothes tag
                span.work-card__line(aria-hidden='true')
                span.work-card__cat Branding
          article.work-card(data-category='print')
            a.work-card__link(href='#work-2')
              img.work-card__img(
                src='../assets/work-02.webp'
                alt='Piece Paper graphic print project'
