section.hero
  .container
    h1.hero__title We&apos;re Keepsake, a digital &amp; branding agency
    p.hero__subtitle Specializing in web design, poster, motion video, based in London. We love to turn ideas into beautiful things.
    .hero__actions
      +btn('See our works', '#works', 'primary')
      +btn('Get in touch', '#contact', 'outline')

section#works.section.portfolio
  .container
    .portfolio__top
      h2.section-title Our awesome works
      .filters-wrapper
        each filter in portfolioFilters
          input.filter-input(
            id=`filter-${filter.id}`
            class=`filter-input--${filter.id}`
            type='radio'
            name='portfolio-filter'
            checked=filter.checked
          )
        .filters(role='group' aria-label='Filter works by category')
          each filter in portfolioFilters
            label.chip(class=`chip--${filter.id}` for=`filter-${filter.id}`)= filter.label
        .portfolio-grid
          each work in works
            article.work-card(data-category=work.category)
              a.work-card__link(href=work.href)
                if work.lazy
                  img.work-card__img(
                    src=work.src
                    alt=work.alt
                    width=work.width
                    height=work.height
                    loading='lazy'
                  )
                else
                  img.work-card__img(
                    src=work.src
                    alt=work.alt
                    width=work.width
                    height=work.height
                  )
                .work-card__overlay
                  span.work-card__plus(aria-hidden='true') +
                  h3.work-card__title= work.title
                  span.work-card__line(aria-hidden='true')
                  span.work-card__cat= work.categoryLabel
    .portfolio__more
      +btn('Load more works', null, 'outline')
