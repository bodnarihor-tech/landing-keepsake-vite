section.section.cta
  .container.cta__inner
    h2.cta__title Would you love to work with us?
    +btn('Contact us', '#contact').btn--primary
      +icon('mail')

section#about.section.services
  .container
    h2.section-title What do we do
    p.section-lead We are a small team of designers and makers who help brands look their best online and offline.
    .services-list
      each service, i in services
        article.service-item
          .service-item__icon(aria-hidden='true')
            +icon(service.icon)
          h3.service-item__title= service.title
          p.service-item__desc= service.desc

section.section.stats(aria-label='Agency statistics')
  .container
    .stats__inner
      each stat, i in stats
        .stat-item
          span.stat-item__value= stat.value
          span.stat-item__label= stat.label

section.section.clients
  .container
    h2.section-title Clients &amp; kind words
    p.section-lead Some of the teams that trusted us with their brands.
    ul.clients-logos
      each client, i in clients
        li.client-logo(class=client.modifier)= client.name
    blockquote.testimonial
      span.testimonial__quote(aria-hidden='true') &ldquo;
      p.testimonial__text Keepsake turned a vague brief into a brand we are proud of. The team was fast, honest about trade-offs and obsessed with the details.
      footer.testimonial__footer
        .testimonial__author
          span.testimonial__avatar(aria-hidden='true') OM
          div
            cite.testimonial__name Olena Marchenko
            span.testimonial__role Marketing Lead, Nordly
        .testimonial__dots(aria-hidden='true')
          span.dot.is-active
          span.dot
          span.dot
