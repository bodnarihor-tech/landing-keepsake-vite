include ../mixins/mixins
include ../data/data
doctype html
html(lang='en')
  include ../includes/head
    block extraHead
  body#top
    main
      block content
    block extraScripts
  body#top
    input#nav-toggle.nav-toggle(type='checkbox' aria-hidden='true')
    include ../components/header
    main
      block content
    a.back-to-top(href='#top' aria-label='Back to top')
      svg(
        width='14'
        height='14'
        viewBox='0 0 14 14'
        fill='none'
        stroke='currentColor'
        stroke-width='1.8'
        aria-hidden='true'
      )
        path(d='M7 12V2M2.5 6.5L7 2l4.5 4.5')
    include ../components/footer
    script(type='module' src='/src/styles/main.scss')
